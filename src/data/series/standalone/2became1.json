            "type": "text",
            "value": "in Christ",
            "marks": [
              "em"
            ]
          },
          {
            "type": "text",
            "value": " were made to sit in heavenly places [Eph. 2:6] "
          }
        ],
        [
          {
            "type": "text",
            "value": "Mortal, but "
          },
          {
            "type": "text",
