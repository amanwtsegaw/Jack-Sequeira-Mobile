{
  "slug": "bstudy21",
  "seriesSlug": "bstudy",
  "sequence": 21,
  "title": "Bible Study 21: Investigative Judgment",
  "description": "Bible Study - God So Loved the World (Part 21: The Investigative Judgment)",
  "keywords": [
    "Holy Bible",
    "Bible study",
